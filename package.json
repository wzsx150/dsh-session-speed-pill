{
  "name": "dsh-session-speed-pill",
  "version": "0.13.0",
  "private": true,
  "description": "「会话速度胶囊」：在每轮对话下方的消息操作行里加一枚读数，位于用量右侧、时间左侧；点开的弹层沿用官方统计弹层样式，给出回答耗时（模型/工具/总）、首字延迟、解码输出、预填充估算、解码与预填充速度区间以及总用量。设置里另有「始终显示消息操作行」开关，一处同时管助手回复与你发出的消息。",
  "author": "wzsx150",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wzsx150/dsh-session-speed-pill.git"
  },
  "homepage": "https://github.com/wzsx150/dsh-session-speed-pill#readme",
  "bugs": {
    "url": "https://github.com/wzsx150/dsh-session-speed-pill/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "session",
    "speed",
    "tps",
    "latency"
  ],
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs/*.md",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT"
}
